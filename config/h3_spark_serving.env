# Validated DGX Spark serving defaults for MiniMax H3.
H3_ATTENTION=sage2-quality
H3_MODULATION_FUSION=exact
H3_REF_IMAGE_SIZE=match
H3_SWIGLU_NVFP4_FUSION=auto
H3_RMS_ADALN_NVFP4_FUSION=auto
H3_Q_RMS_ROPE_INT8_FUSION=auto

# First-block cache: keep off. Not an exact skip. Do not raise the threshold.
H3_CROSS_STEP_CACHE=off

# Cross-block final-gate -> next QKV. HOLD. Default stock.
# H3_CROSSBLOCK_GATE_QKV_FUSION=stock

# Static scales remain intentionally disabled until verify_promotion.py exits 0.
H3_NVFP4_STATIC_ARTIFACT=
H3_NVFP4_EXCLUDED_LAYERS=

# Same-tile VAE decode/encode batching (256 px tiles). Rollback off.
COMFY_MINIMAX_H3_VAE_BATCH_TILES=auto
# VAE Q/K RMS + split-half RoPE. CUDA is ULP, not byte-exact. Default off.
COMFY_MINIMAX_H3_VAE_RMS_ROPE=off
# VAE SwiGLU silu(gate)*up native (eager two-rounding). Rollback off.
COMFY_MINIMAX_H3_VAE_SILU_MUL=auto
# GPU fp16 downcast before Comfy host HtoD. Rollback off.
COMFY_MINIMAX_H3_VAE_HOST_FP16=auto
# Decode stays [0, 1]; skip *2-1 and Comfy process_output (+1/2). Identity.
# Rollback off (restores signed decode + process_output).
COMFY_MINIMAX_H3_VAE_UNIT_INTERVAL=auto
# Persistent host decode buffer (skip 2.3 s first-touch HtoD). Rollback off.
COMFY_MINIMAX_H3_VAE_HOST_BUF=auto
# GPU NHWC before host stage so SaveVideo sees contiguous frames. Rollback off.
COMFY_MINIMAX_H3_VAE_NHWC=auto
# Qwen 50-layer LM compute dtype. Default off (fp32). Not an identity.
# Isolated MLP S=2800: fp32 245 ms/layer vs bf16 26 ms (~12 s vs 1.3 s / 50).
# COMFY_MINIMAX_H3_QWEN_LM_DTYPE=bf16

# Immediate rollback:
# H3_ATTENTION=stock
# H3_MODULATION_FUSION=stock
# H3_SWIGLU_NVFP4_FUSION=stock
# H3_RMS_ADALN_NVFP4_FUSION=stock
# H3_Q_RMS_ROPE_INT8_FUSION=stock
# H3_CROSS_STEP_CACHE=off
# COMFY_MINIMAX_H3_VAE_BATCH_TILES=off
# COMFY_MINIMAX_H3_VAE_SILU_MUL=off
